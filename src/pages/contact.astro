---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/ContactSection.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
---

<BaseLayout
  title="Contact — GidsTek"
  description="Contact GidsTek in Mumbai. WhatsApp for fastest response. Call, email, or visit us at Kurla West."
  canonicalUrl="https://gidstek.com/contact/"
>
  <div class="bg-[#1a2744] py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm font-medium text-[#43b8de] uppercase tracking-widest mb-2">Reach Us</p>
      <h1 class="text-4xl font-bold text-white">Contact GidsTek</h1>
      <p class="text-white/60 mt-3">WhatsApp is the fastest way to reach us. We respond within the hour.</p>
    </div>
  </div>

  <WhatsAppCTA variant="banner" message="Hi GidsTek, I'm on your contact page and need help." />
  <ContactSection />
</BaseLayout>
