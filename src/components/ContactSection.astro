---
import { SITE } from '../data/site';
const waHref = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent('Hi GidsTek, I found your website and would like to get in touch.')}`;
---

<section class="py-16 px-4 bg-white">
  <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-start">
    <!-- Info -->
    <div class="flex flex-col gap-6">
      <div>
        <p class="text-sm font-medium text-[#43b8de] uppercase tracking-widest mb-2">Get In Touch</p>
        <h2 class="text-3xl font-bold text-[#1a2744]">Let's Talk Hardware</h2>
        <p class="text-gray-500 mt-3">
          Send us a WhatsApp — we respond within the hour. For RFQs, bulk orders, or onsite visits in Mumbai.
        </p>
      </div>

      <div class="flex flex-col gap-4">
        <a href={waHref} target="_blank" rel="noopener noreferrer"
          class="flex items-center gap-4 p-4 rounded-xl border border-gray-100 hover:border-[#25D366]/40 hover:bg-green-50/50 transition-colors group">
          <div class="w-12 h-12 rounded-full flex items-center justify-center shrink-0" style="background-color: #25D366;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="white" width="22" height="22"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          </div>
          <div>
            <p class="font-semibold text-gray-900">WhatsApp (Preferred)</p>
            <p class="text-sm text-gray-500">{SITE.phone} — fastest response</p>
          </div>
        </a>

        <a href={`tel:${SITE.phone}`}
          class="flex items-center gap-4 p-4 rounded-xl border border-gray-100 hover:border-[#43b8de]/40 hover:bg-[#f0f8fc] transition-colors">
          <div class="w-12 h-12 rounded-full bg-[#43b8de]/10 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#43b8de" width="22" height="22"><path fill-rule="evenodd" d="M1.5 4.5a3 3 0 013-3h1.372c.86 0 1.61.586 1.819 1.42l1.105 4.423a1.875 1.875 0 01-.694 1.955l-1.293.97c-.135.101-.164.249-.126.352a11.285 11.285 0 006.697 6.697c.103.038.25.009.352-.126l.97-1.293a1.875 1.875 0 011.955-.694l4.423 1.105c.834.209 1.42.959 1.42 1.82V19.5a3 3 0 01-3 3h-2.25C8.552 22.5 1.5 15.448 1.5 6.75V4.5z" clip-rule="evenodd"/></svg>
          </div>
          <div>
            <p class="font-semibold text-gray-900">Call Us</p>
            <p class="text-sm text-gray-500">{SITE.phone}</p>
          </div>
        </a>

        <a href={`mailto:${SITE.email}`}
          class="flex items-center gap-4 p-4 rounded-xl border border-gray-100 hover:border-[#43b8de]/40 hover:bg-[#f0f8fc] transition-colors">
          <div class="w-12 h-12 rounded-full bg-[#43b8de]/10 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#43b8de" width="22" height="22"><path d="M1.5 8.67v8.58a3 3 0 003 3h15a3 3 0 003-3V8.67l-8.928 5.493a3 3 0 01-3.144 0L1.5 8.67z"/><path d="M22.5 6.908V6.75a3 3 0 00-3-3h-15a3 3 0 00-3 3v.158l9.714 5.978a1.5 1.5 0 001.572 0L22.5 6.908z"/></svg>
          </div>
          <div>
            <p class="font-semibold text-gray-900">Email</p>
            <p class="text-sm text-gray-500">{SITE.email}</p>
          </div>
        </a>

        <div class="flex items-start gap-4 p-4 rounded-xl border border-gray-100">
          <div class="w-12 h-12 rounded-full bg-[#43b8de]/10 flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#43b8de" width="22" height="22"><path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-2.003 3.5-4.697 3.5-8.333 0-4.552-3.508-7.5-7.5-7.5S4 2.648 4 7.205c0 3.636 1.556 6.33 3.5 8.332a19.58 19.58 0 002.683 2.283 16.974 16.974 0 001.357.776zm.46-12.116a2.25 2.25 0 100 4.5 2.25 2.25 0 000-4.5z" clip-rule="evenodd"/></svg>
          </div>
          <div>
            <p class="font-semibold text-gray-900">Visit Us</p>
            <p class="text-sm text-gray-500">{SITE.address.street}, {SITE.address.city} – {SITE.address.pin}, {SITE.address.state}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Map -->
    <div class="rounded-xl overflow-hidden border border-gray-100 shadow-sm">
      <iframe
        src="https://www.google.com/maps?q=Kurla+West+Mumbai+400070+Maharashtra&output=embed"
        width="100%"
        height="400"
        style="border:0;"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="GidsTek Office — Kurla West, Mumbai"
        aria-label="Map showing GidsTek office location in Kurla West, Mumbai"
      ></iframe>
    </div>
  </div>
</section>
