---
import { SITE } from '../data/site';

const currentYear = new Date().getFullYear();
const quickLinks = [
  { label: 'Hardware Catalog', href: '/hardware/' },
  { label: 'Services', href: '/services/' },
  { label: 'About Us', href: '/about/' },
  { label: 'Contact', href: '/contact/' },
];
---

<footer class="bg-[#1a2744] text-white/80">
  <div class="max-w-6xl mx-auto px-4 py-12 grid grid-cols-1 md:grid-cols-3 gap-8">
    <!-- Brand column -->
    <div class="flex flex-col gap-4">
      <img src="/images/logo.png" alt="GidsTek" width="150" height="38" class="h-9 w-auto object-contain" loading="lazy" />
      <p class="text-sm leading-relaxed text-white/60">
        {SITE.name} is a technology brand of {SITE.legalName}. We supply and support IT hardware and digital solutions for businesses across Mumbai.
      </p>
      <div class="flex items-center gap-3">
        <a href={SITE.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="hover:text-[#43b8de] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="hover:text-[#43b8de] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href={SITE.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="hover:text-[#43b8de] transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
        </a>
      </div>
    </div>

    <!-- Quick links -->
    <div>
      <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Quick Links</h3>
      <ul class="flex flex-col gap-2">
        {quickLinks.map(link => (
          <li>
            <a href={link.href} class="text-sm hover:text-[#43b8de] transition-colors flex items-center gap-2">
              <span class="text-[#43b8de]">›</span> {link.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Contact info -->
    <div>
      <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Contact Us</h3>
      <ul class="flex flex-col gap-3 text-sm">
        <li class="flex items-start gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#43b8de" width="16" height="16" class="shrink-0 mt-0.5"><path fill-rule="evenodd" d="M9.69 18.933l.003.001C9.89 19.02 10 19 10 19s.11.02.308-.066l.002-.001.006-.003.018-.008a5.741 5.741 0 00.281-.14c.186-.096.446-.24.757-.433.62-.384 1.445-.966 2.274-1.765C15.302 15.012 17 12.493 17 9A7 7 0 103 9c0 3.492 1.698 6.012 3.354 7.385a13.318 13.318 0 002.273 1.765 11.842 11.842 0 00.976.544l.062.029.018.008.006.003zM10 11.25a2.25 2.25 0 100-4.5 2.25 2.25 0 000 4.5z" clip-rule="evenodd"/></svg>
          <span>{SITE.address.street}, {SITE.address.city} – {SITE.address.pin}, {SITE.address.state}, India</span>
        </li>
        <li>
          <a href={`tel:${SITE.phone}`} class="flex items-center gap-2 hover:text-[#43b8de] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#43b8de" width="16" height="16"><path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 006.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 011.767-1.052l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 012.43 8.326 13.019 13.019 0 012 5V3.5z" clip-rule="evenodd"/></svg>
            {SITE.phone}
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} class="flex items-center gap-2 hover:text-[#43b8de] transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#43b8de" width="16" height="16"><path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z"/><path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z"/></svg>
            {SITE.email}
          </a>
        </li>
        {SITE.gst !== 'YOUR_GST_NUMBER' && (
          <li class="text-xs text-white/50 pt-1">GSTIN: {SITE.gst}</li>
        )}
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10 py-4 px-4 text-center text-xs text-white/40">
    <p>© {currentYear} {SITE.name} — a brand of {SITE.legalName}. All rights reserved.</p>
  </div>
</footer>
