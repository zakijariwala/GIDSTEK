---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HardwareCatalog from '../../components/HardwareCatalog.astro';
import WhatsAppCTA from '../../components/WhatsAppCTA.astro';
import { hardwareItems } from '../../data/hardware';
---

<BaseLayout
  title="Hardware Catalog — GidsTek"
  description="Browse GidsTek's full IT hardware catalog. Lenovo, HP, Dell laptops and servers. Cisco switches and firewalls. APC UPS. Hikvision CCTV. All with WhatsApp inquiry."
  canonicalUrl="https://gidstek.com/hardware/"
>
  <div class="bg-[#1a2744] py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm font-medium text-[#43b8de] uppercase tracking-widest mb-2">All Products</p>
      <h1 class="text-4xl font-bold text-white">Hardware Catalog</h1>
      <p class="text-white/60 mt-3 max-w-xl">
        All items are available for single-unit and bulk purchase. Pricing on request — WhatsApp us for a same-day quote.
      </p>
    </div>
  </div>

  <HardwareCatalog items={hardwareItems} showFilters={true} title="All Products" />

  <WhatsAppCTA
    variant="inline"
    message="Hi GidsTek, I'm looking at your hardware catalog and need a bulk quote. Can you help?"
    label="Request a Bulk Quote"
  />
</BaseLayout>
