---

<section class="py-16 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-12">
      <p class="text-sm font-medium text-[#43b8de] uppercase tracking-widest mb-2">What We Do</p>
      <h2 class="text-3xl font-bold text-[#1a2744]">Our Services</h2>
      <p class="text-gray-500 mt-3 max-w-xl mx-auto">
        End-to-end IT solutions for businesses in Mumbai — from hardware procurement to web and app development.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map(service => (
        <div class="group p-6 rounded-xl border border-gray-100 hover:border-[#43b8de]/40 hover:shadow-md transition-all duration-200 flex flex-col gap-4">
          <div class="w-12 h-12 rounded-xl bg-[#f0f8fc] flex items-center justify-center group-hover:bg-[#43b8de]/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="#43b8de" width="24" height="24">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[service.id]} />
            </svg>
          </div>

          <div>
            <h3 class="font-semibold text-[#1a2744] text-base mb-2">{service.title}</h3>
            <p class="text-sm text-gray-500 leading-relaxed">{service.description}</p>
          </div>

          <ul class="flex flex-col gap-1.5">
            {service.bullets.map(bullet => (
              <li class="flex items-center gap-2 text-xs text-gray-600">
                <span class="w-1.5 h-1.5 rounded-full bg-[#43b8de] shrink-0"></span>
                {bullet}
              </li>
            ))}
          </ul>

          <a
            href={`https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent(service.waMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-auto text-sm font-medium text-[#43b8de] hover:text-[#1a2744] transition-colors flex items-center gap-1"
          >
            Inquire on WhatsApp →
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
