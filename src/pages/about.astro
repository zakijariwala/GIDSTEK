---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppCTA from '../components/WhatsAppCTA.astro';
import { SITE } from '../data/site';
---

<BaseLayout
  title="About Us — GidsTek"
  description="GidsTek is a technology brand of ALH Solutions, based in Kurla West, Mumbai. GST-registered IT hardware supplier and solutions provider since 2016."
  canonicalUrl="https://gidstek.com/about/"
>
  <div class="bg-[#1a2744] py-12 px-4">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm font-medium text-[#43b8de] uppercase tracking-widest mb-2">Who We Are</p>
      <h1 class="text-4xl font-bold text-white">About GidsTek</h1>
    </div>
  </div>

  <section class="py-16 px-4">
    <div class="max-w-4xl mx-auto flex flex-col gap-10">
      <div class="grid md:grid-cols-2 gap-10 items-start">
        <div>
          <h2 class="text-2xl font-bold text-[#1a2744] mb-4">Our Story</h2>
          <p class="text-gray-600 leading-relaxed mb-4">
            GidsTek is a technology brand of <strong>{SITE.legalName}</strong>, based in Kurla (West), Mumbai.
            We supply IT hardware and deliver technology solutions for businesses across Maharashtra.
          </p>
          <p class="text-gray-600 leading-relaxed mb-4">
            From a single laptop purchase to full office IT infrastructure — switches, servers, UPS, CCTV,
            and access control — we handle procurement, delivery, configuration, and ongoing support.
          </p>
          <p class="text-gray-600 leading-relaxed">
            As a GST-registered business, we issue proper tax invoices for all hardware and services,
            making B2B procurement straightforward and compliant.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <div class="bg-[#f0f8fc] rounded-xl p-6 border border-[#43b8de]/20">
            <h3 class="font-semibold text-[#1a2744] mb-4">Company Details</h3>
            <dl class="flex flex-col gap-3 text-sm">
              <div class="flex justify-between gap-4">
                <dt class="text-gray-500">Brand Name</dt>
                <dd class="font-medium text-gray-900">{SITE.name}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-gray-500">Legal Entity</dt>
                <dd class="font-medium text-gray-900">{SITE.legalName}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-gray-500">Location</dt>
                <dd class="font-medium text-gray-900">{SITE.address.street}, {SITE.address.city}</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-gray-500">Phone</dt>
                <dd class="font-medium text-gray-900">
                  <a href={`tel:${SITE.phone}`} class="text-[#43b8de] hover:underline">{SITE.phone}</a>
                </dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-gray-500">Email</dt>
                <dd class="font-medium text-gray-900">
                  <a href={`mailto:${SITE.email}`} class="text-[#43b8de] hover:underline">{SITE.email}</a>
                </dd>
              </div>
              {SITE.gst !== 'YOUR_GST_NUMBER' && (
                <div class="flex justify-between gap-4 pt-2 border-t border-[#43b8de]/20">
                  <dt class="text-gray-500">GSTIN</dt>
                  <dd class="font-medium text-gray-900 font-mono text-xs">{SITE.gst}</dd>
                </div>
              )}
            </dl>
          </div>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[#1a2744] mb-6">Our Vision</h2>
        <blockquote class="border-l-4 border-[#43b8de] pl-6 text-gray-600 italic leading-relaxed text-lg">
          "To be a Customer-Centric and Customer-Loyal company that delivers the highest quality services
          and empowers our clients with technology."
        </blockquote>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-[#1a2744] mb-6">What We Supply</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {['Lenovo Business Laptops', 'HP ProBook & EliteBook', 'Dell PowerEdge Servers', 'Cisco Networking', 'APC UPS & Power', 'Hikvision CCTV'].map(item => (
            <div class="flex items-center gap-2 text-sm text-gray-700">
              <span class="w-2 h-2 rounded-full bg-[#43b8de] shrink-0"></span>
              {item}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <WhatsAppCTA
    variant="inline"
    message="Hi GidsTek, I'd like to learn more about your company and services."
    label="Get In Touch"
  />
</BaseLayout>
