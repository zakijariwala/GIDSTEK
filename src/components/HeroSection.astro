---
import { SITE } from '../data/site';
const waHref = `https://wa.me/${SITE.whatsapp}?text=${encodeURIComponent("Hi GidsTek, I'd like to know more about your IT hardware and services.")}`;
---

<section
  class="relative min-h-[92vh] flex items-center justify-center overflow-hidden"
  style="background-color: #0f1a30;"
>
  <!-- Background image -->
  <img
    src="/images/hero1.jpg"
    alt=""
    aria-hidden="true"
    width="1200"
    height="600"
    class="absolute inset-0 w-full h-full object-cover opacity-30"
    loading="eager"
    fetchpriority="high"
  />

  <!-- Gradient overlay -->
  <div class="absolute inset-0 bg-gradient-to-r from-[#0f1a30]/90 via-[#1a2744]/70 to-transparent"></div>

  <div class="relative z-10 max-w-6xl mx-auto px-4 py-20 grid md:grid-cols-2 gap-12 items-center">
    <div class="flex flex-col gap-6">
      <!-- Badge -->
      <span class="inline-flex items-center gap-2 text-sm font-medium text-[#43b8de] bg-[#43b8de]/10 border border-[#43b8de]/30 rounded-full px-4 py-1.5 w-fit">
        <span class="w-2 h-2 rounded-full bg-[#43b8de] animate-pulse"></span>
        Mumbai's Trusted IT Partner Since 2016
      </span>

      <h1 class="text-4xl md:text-5xl font-bold text-white leading-tight">
        IT Hardware &amp;<br/>Solutions for<br/>
        <span class="text-[#43b8de]">Mumbai Businesses</span>
      </h1>

      <p class="text-lg text-white/70 leading-relaxed max-w-md">
        Lenovo, HP, Dell laptops and servers. Cisco networking. APC power backup. Hikvision CCTV.
        Supplied, configured, and supported — all from one trusted partner.
      </p>

      <ul class="flex flex-col gap-2 text-white/60 text-sm">
        {['GST-registered business — proper invoicing for B2B', 'Same-day response on all inquiries', '3-year onsite warranty support available', 'Bulk and single-unit pricing'].map(point => (
          <li class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="#43b8de" width="16" height="16"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd"/></svg>
            {point}
          </li>
        ))}
      </ul>

      <div class="flex flex-col sm:flex-row gap-4 pt-2">
        <a
          href="/hardware/"
          class="flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold text-white bg-[#43b8de] hover:bg-[#2fa8cf] transition-colors"
        >
          Browse Hardware
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16"><path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd"/></svg>
        </a>
        <a
          href={waHref}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 px-6 py-3 rounded-full font-semibold text-white border border-[#25D366] hover:bg-[#25D366]/10 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#25D366" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Us Now
        </a>
      </div>
    </div>

    <!-- Stats panel -->
    <div class="hidden md:grid grid-cols-2 gap-4">
      {[
        { value: '500+', label: 'Businesses Served' },
        { value: '8+', label: 'Years in Mumbai' },
        { value: '24hr', label: 'Turnaround SLA' },
        { value: 'GST', label: 'Registered Business' },
      ].map(stat => (
        <div class="bg-white/5 border border-white/10 rounded-xl p-6 flex flex-col items-center text-center backdrop-blur-sm">
          <span class="text-3xl font-bold text-[#43b8de]">{stat.value}</span>
          <span class="text-sm text-white/60 mt-1">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-white/30 text-xs">
    <span>Scroll</span>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" width="16" height="16" class="animate-bounce"><path fill-rule="evenodd" d="M10 3a.75.75 0 01.75.75v10.638l3.96-4.158a.75.75 0 111.08 1.04l-5.25 5.5a.75.75 0 01-1.08 0l-5.25-5.5a.75.75 0 111.08-1.04l3.96 4.158V3.75A.75.75 0 0110 3z" clip-rule="evenodd"/></svg>
  </div>
</section>
